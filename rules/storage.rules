rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isPhotoWrite() {
      return request.resource == null || (request.resource.size <= 800 * 1024 && request.resource.contentType.matches('image/.*'));
    }

    match /diagnostics/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /flags/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isPhotoWrite();
    }

    match /dispatch/{ticketId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPhotoWrite();
    }

    match /payments/{paymentId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPhotoWrite();
    }
  }
}
