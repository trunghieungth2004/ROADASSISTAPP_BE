{
  "compilerOptions": {
    "module": "Node16",
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "target": "es2020",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "compileOnSave": true,
  "include": [
    "index.ts",
    "config/**/*.ts",
    "controller/**/*.ts",
    "service/**/*.ts",
    "repository/**/*.ts",
    "middleware/**/*.ts",
    "validation/**/*.ts",
    "routes/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "test"
  ]
}
