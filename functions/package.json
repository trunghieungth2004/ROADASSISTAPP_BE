{
  "name": "functions",
  "description": "RoadAssist backend Cloud Functions",
  "scripts": {
    "serve": "npm run build && firebase emulators:start --only functions",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint --ext .js,.ts .",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "test": "JEST_JUNIT_OUTPUT_DIR=test-report JEST_JUNIT_OUTPUT_NAME=junit.xml npx jest",
    "test:unit": "npm test",
    "test:integration": "firebase emulators:start --only firestore,auth,storage --project test-project &>/dev/null & _EPID=$!; sleep 4; FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 STORAGE_EMULATOR_HOST=http://localhost:9199 GCLOUD_PROJECT=test-project JEST_JUNIT_OUTPUT_DIR=test-report JEST_JUNIT_OUTPUT_NAME=integration-junit.xml npx jest --config jest.integration.config.js --runInBand; _RC=$?; kill $_EPID 2>/dev/null; exit $_RC",
    "test:all": "npm test && npm run test:integration",
    "test:report": "JEST_JUNIT_OUTPUT_DIR=test-report JEST_JUNIT_OUTPUT_NAME=junit.xml jest --reporters=default --reporters=jest-junit --reporters=./test/reporters/markdownReporter.js",
    "deploy": "firebase deploy --only functions",
    "db:init": "npm run build && node lib/scripts/db.init.js",
    "db:init:emulator": "FUNCTIONS_EMULATOR=true FIRESTORE_EMULATOR_HOST=localhost:8080 GCLOUD_PROJECT=demo npm run db:init",
    "queue:init": "npm run build && node lib/scripts/createTaskQueue.js",
    "valhalla:setup": "bash ../infra/valhalla/setup.sh",
    "valhalla:remove": "bash ../infra/valhalla/remove.sh",
    "push:setup": "npm run build && node lib/scripts/setupPush.js",
    "push:check": "npm run build && node lib/scripts/setupPush.js --check",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/aiplatform": "^6.11.0",
    "@google-cloud/tasks": "^4.1.0",
    "@turf/bearing": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "@turf/destination": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/line-intersect": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "joi": "^18.2.3",
    "lru-cache": "^11.5.2",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "preset": "ts-jest",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testMatch": [
      "**/test/unit/**/*.test.ts"
    ],
    "setupFiles": [
      "<rootDir>/test/setup/unit.ts"
    ],
    "reporters": [
      "default",
      "jest-junit",
      "<rootDir>/test/reporters/markdownReporter.js"
    ]
  }
}
