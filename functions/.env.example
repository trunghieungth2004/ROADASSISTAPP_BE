# Copy to functions/.env (gitignored) and fill in. VALHALLA_URL is written
# automatically by infra/valhalla/setup.sh on firebase deploy — set it here
# only for local/emulator runs.
VALHALLA_URL=http://localhost:8002
ALLOWED_ORIGINS=
ROUTING_CACHE_TTL_SECONDS=7776000
FCM_ENABLED=false
CLOUD_TASKS_ENABLED=false
PUSH_DELIVER_URL=
TASK_INVOKER_EMAIL=
TASK_QUEUE_LOCATION=asia-southeast1
